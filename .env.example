# Node Roles
RODENT_NODE_ROLE=detection
RODENT_DETECTION_NODE=roland1
RODENT_INFERENCE_NODE=roland3
RODENT_SUPABASE_NODE=roland1

# Camera & Ring settings (roland1)
RODENT_RING_TOKEN_FILE=ring_token.json
RODENT_RING_DEVICE_NAME=
RODENT_RING_SAMPLE_INTERVAL=20

# AI Inference settings (roland3)
RODENT_INFERENCE_ENDPOINT_URL=http://roland3:11434
RODENT_INFERENCE_ENDPOINT_TYPE=ollama
RODENT_INFERENCE_MODEL_NAME=gemma-4-e12b
RODENT_INFERENCE_THRESHOLD=0.65

# Supabase Database Services (roland1)
RODENT_STORAGE_BACKEND=auto
RODENT_SUPABASE_URL=http://roland1:54321
RODENT_SUPABASE_KEY=
RODENT_SUPABASE_TABLE=detections
RODENT_SUPABASE_BUCKET=detections

